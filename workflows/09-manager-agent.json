{
  "name": "9 - Manager & Owner Agent (Telegram)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "id": "manager-telegram-trigger-01",
      "name": "Telegram Owner Trigger",
      "credentials": {
        "telegramApi": {
          "name": "Telegram Manager Bot"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "אתה העוזר העסקי הבכיר והאנליסט התפעולי של ירון לבגורן, בעלים ומנכ\"ל חברת 'איי.איי אלקטרוניקה בע\"מ' (AI Electronics Ltd).\n\nתפקידך לסייע לירון בניהול העסק, קבלת החלטות, ניתוח נתונים ודוחות סטטוס:\n1. מנהל ומנכ\"ל: פנה לירון תמיד בכבוד ובמקצועיות כבעל הבית (\"שלום ירון\").\n2. דוחות מלאי ותפעול: הסתמך על מאגר המוצרים (products_search) כדי לאתר מוצרים במלאי נמוך (מתחת ל-5 יחידות), מפרטים ומחירים.\n3. מדיניות, תמחור וגבייה: הסתמך על מאגר המדיניות (policies_search) לגבי תנאי תשלום (שוטף+30), הנחות כמות B2B, מע\"מ 18% (מ-1.1.2025), ואחריות יבואן רשמי.\n4. תשובות מדויקות: ספק מספרים מדויקים בשקלים (₪), ניתוח עלויות מול מחירי מכירה, ודוחות תמציתיים ומובנים."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        460,
        300
      ],
      "id": "manager-agent-01",
      "name": "Manager Executive Agent"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        380,
        520
      ],
      "id": "manager-chat-model-01",
      "name": "Chat Model",
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "name": "policies_search",
        "description": "חיפוש במדיניות החברה: תנאי תשלום שוטף+30, הנחות B2B, מע\"מ 18%, החזרות ואחריות יבואן רשמי"
      },
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
      "position": [
        540,
        520
      ],
      "id": "manager-tool-policies-01",
      "name": "Policies Tool"
    },
    {
      "parameters": {
        "mode": "retrieve",
        "memoryKey": {
          "__rl": true,
          "value": "mypolicies",
          "mode": "list",
          "cachedResultName": "mypolicies"
        },
        "topK": 4
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1,
      "position": [
        540,
        700
      ],
      "id": "manager-vector-policies-01",
      "name": "Policies Vector Store"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        500,
        860
      ],
      "id": "manager-embeddings-policies-01",
      "name": "Policies Embeddings",
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "name": "products_search",
        "description": "חיפוש בקטלוג המוצרים: בדיקת רמות מלאי, התראות מלאי נמוך, מפרטים ומחירי מוצרים"
      },
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
      "position": [
        700,
        520
      ],
      "id": "manager-tool-products-01",
      "name": "Products Tool"
    },
    {
      "parameters": {
        "mode": "retrieve",
        "memoryKey": {
          "__rl": true,
          "value": "theproducts",
          "mode": "list",
          "cachedResultName": "theproducts"
        },
        "topK": 4
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1,
      "position": [
        700,
        700
      ],
      "id": "manager-vector-products-01",
      "name": "Products Vector Store"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        700,
        860
      ],
      "id": "manager-embeddings-products-01",
      "name": "Products Embeddings",
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Owner Trigger').first().json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        860,
        300
      ],
      "id": "manager-telegram-send-01",
      "name": "Telegram Send Reply",
      "credentials": {
        "telegramApi": {
          "name": "Telegram Manager Bot"
        }
      }
    }
  ],
